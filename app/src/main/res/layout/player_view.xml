<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerView dgn permukaan TextureView: wajib buat fitur tangkap frame
     (SurfaceView tidak bisa dibaca bitmap-nya). Kontrol bawaan MATI —
     semua kontrol digambar Compose ala pemutar video Samsung. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:use_controller="false"
    app:surface_type="texture_view"
    app:resize_mode="fit"
    app:shutter_background_color="#000000" />
